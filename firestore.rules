rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isProfessor() {
      return request.auth != null
        && request.auth.token.email == 'pro.david.hebert@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function classMatchesCourseLevel(classId, courseId) {
      return exists(/databases/$(database)/documents/teacherClasses/$(classId))
        && exists(/databases/$(database)/documents/courses/$(courseId))
        && get(/databases/$(database)/documents/teacherClasses/$(classId)).data.level
          == get(/databases/$(database)/documents/courses/$(courseId)).data.level;
    }

    function validCourse(data) {
      return data.keys().hasOnly([
          'id', 'title', 'slug', 'chapterNumber', 'level', 'blocks',
          'exerciseFileId', 'exerciseFileName', 'slideCount', 'status',
          'manualOrder', 'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.slug is string
        && data.chapterNumber is string && data.chapterNumber.size() <= 20
        && data.level in ['6', '5', '4', '3']
        && data.blocks is list && data.blocks.size() <= 200
        && data.exerciseFileId is string && data.exerciseFileId.size() <= 160
        && data.exerciseFileName is string && data.exerciseFileName.size() <= 160
        && data.slideCount is int && data.slideCount >= 1 && data.slideCount <= 200
        && data.status in ['draft', 'published']
        && (data.manualOrder == null || (data.manualOrder is int && data.manualOrder >= 0 && data.manualOrder <= 999))
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function validLegacyCourse(data) {
      return data.keys().hasOnly([
          'id', 'title', 'slug', 'level', 'category', 'summary', 'content',
          'status', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.level in ['6', '5', '4', '3']
        && data.content is string && data.content.size() <= 200000
        && data.status in ['draft', 'published'];
    }

    function validImage(data) {
      return data.keys().hasOnly([
          'id', 'courseId', 'dataUrl', 'alt', 'published', 'createdAt'
        ])
        && data.id is string
        && data.courseId is string
        && data.dataUrl is string && data.dataUrl.size() > 0 && data.dataUrl.size() <= 750000
        && data.alt is string && data.alt.size() <= 160
        && data.published is bool
        && data.createdAt is string;
    }

    function validFile(data) {
      return data.keys().hasOnly([
          'id', 'courseId', 'dataUrl', 'name', 'published', 'createdAt'
        ])
        && data.id is string
        && data.courseId is string
        && data.dataUrl is string && data.dataUrl.size() > 0 && data.dataUrl.size() <= 900000
        && data.name is string && data.name.size() > 0 && data.name.size() <= 160
        && data.published is bool
        && data.createdAt is string;
    }

    match /courses/{courseId} {
      allow read: if isProfessor();
      allow create, update: if isProfessor()
        && request.resource.data.id == courseId
        && (validCourse(request.resource.data) || validLegacyCourse(request.resource.data));
      allow delete: if isProfessor();
    }

    match /catalogs/{level} {
      allow read: if true;
      allow write: if isProfessor()
        && level in ['6', '5', '4', '3']
        && request.resource.data.level == level
        && request.resource.data.courses is list
        && request.resource.data.courses.size() <= 200;
    }

    match /publishedCourses/{courseId} {
      allow read: if true;
      allow create, update: if isProfessor()
        && request.resource.data.id == courseId
        && request.resource.data.status == 'published'
        && (validCourse(request.resource.data) || validLegacyCourse(request.resource.data));
      allow delete: if isProfessor();
    }

    match /courseImages/{imageId} {
      allow get: if isProfessor() || resource.data.published == true;
      allow list: if isProfessor();
      allow create, update: if isProfessor()
        && request.resource.data.id == imageId
        && validImage(request.resource.data);
      allow delete: if isProfessor();
    }

    match /courseFiles/{fileId} {
      allow get: if isProfessor() || resource.data.published == true;
      allow list: if isProfessor();
      allow create, update: if isProfessor()
        && request.resource.data.id == fileId
        && validFile(request.resource.data);
      allow delete: if isProfessor();
    }

    match /courseBackups/{backupId} {
      allow read, delete: if isProfessor() && backupId == 'lastReplacement';
      allow create, update: if isProfessor()
        && backupId == 'lastReplacement'
        && request.resource.data.keys().hasOnly(['course', 'createdAt'])
        && validCourse(request.resource.data.course)
        && request.resource.data.createdAt is string;
    }

    match /teacherClasses/{classId} {
      allow read: if isProfessor();
      allow create, update: if isProfessor()
        && request.resource.data.keys().hasOnly(['id', 'level', 'name', 'createdAt'])
        && request.resource.data.id == classId
        && request.resource.data.level in ['6', '5', '4', '3']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data.createdAt is string;
      allow delete: if false;

      match /progress/{courseId} {
        allow read: if isProfessor();
        allow create, update: if isProfessor()
          && request.resource.data.keys().hasOnly([
            'classId', 'courseId', 'slideIndex', 'revealIndex',
            'completedExercises', 'updatedAt'
          ])
          && request.resource.data.classId == classId
          && request.resource.data.courseId == courseId
          && classMatchesCourseLevel(classId, courseId)
          && request.resource.data.slideIndex is int
          && request.resource.data.slideIndex >= 0
          && request.resource.data.slideIndex <= 200
          && request.resource.data.revealIndex is int
          && request.resource.data.revealIndex >= 0
          && request.resource.data.revealIndex <= 200
          && request.resource.data.completedExercises is list
          && request.resource.data.completedExercises.size() <= 401
          && request.resource.data.updatedAt is string;
        allow delete: if false;
      }

      match /journal/{date} {
        allow read: if isProfessor();
        allow create, update: if isProfessor()
          && request.resource.data.keys().hasOnly(['classId', 'date', 'text', 'updatedAt'])
          && request.resource.data.classId == classId
          && request.resource.data.date == date
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 20000
          && request.resource.data.updatedAt is string;
        allow delete: if false;

        match /courses/{courseId} {
          allow read: if isProfessor();
          allow create, update: if isProfessor()
            && request.resource.data.keys().hasOnly([
              'classId', 'date', 'courseId', 'title', 'chapterNumber',
              'level', 'blocks', 'exercises', 'startedAt', 'updatedAt'
            ])
            && request.resource.data.classId == classId
            && request.resource.data.date == date
            && request.resource.data.courseId == courseId
            && classMatchesCourseLevel(classId, courseId)
            && request.resource.data.level
              == get(/databases/$(database)/documents/teacherClasses/$(classId)).data.level
            && request.resource.data.title is string
            && request.resource.data.title.size() <= 120
            && request.resource.data.chapterNumber is string
            && request.resource.data.chapterNumber.size() <= 20
            && request.resource.data.level in ['6', '5', '4', '3']
            && request.resource.data.blocks is list
            && request.resource.data.blocks.size() <= 200
            && request.resource.data.exercises is list
            && request.resource.data.exercises.size() <= 401
            && request.resource.data.startedAt is string
            && request.resource.data.updatedAt is string;
          allow delete: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
